{
  "name": "auto-tstory",
  "version": "0.0.1",
  "private": true,
  "description": "Local Tistory writing workspace",
  "type": "module",
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "p0": "tsx scripts/p0.ts",
    "p0:fixtures": "tsx scripts/create-fixtures.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:browser": "tsx scripts/browser-smoke.ts",
    "dev": "tsx scripts/dev.ts",
    "build": "next build",
    "start": "tsx scripts/dev.ts --production",
    "worker": "tsx scripts/worker.ts",
    "test:web": "tsx scripts/web-smoke.ts"
  },
  "dependencies": {
    "marked": "18.0.12",
    "next": "16.3.4",
    "playwright": "1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanitize-html": "2.17.7",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/sanitize-html": "2.16.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
