# Optional configuration reference only. No API keys are required by this app.
# The launcher/worker do NOT automatically load .env files.
# Set needed values in the parent PowerShell session before npm run dev/start.
# Leave these unset to use defaults. Do not use real credentials in this file.

# TSTORY_CODEX_BIN=C:/path/to/codex.exe
# TSTORY_DATA_DIR=C:/path/outside-repository/tstory-data
# TSTORY_BACKUP_DIR=C:/path/outside-repository/tstory-backups
# Advanced: normally keep the following unset.
# TSTORY_APP_ROOT=C:/path/to/auto_tstory
# TSTORY_RUNTIME_DIR=C:/path/outside-repository/tstory-runtime
# Optional: disable Next telemetry in the inherited environment.
# NEXT_TELEMETRY_DISABLED=1

# TSTORY_INSTANCE_ID is generated by scripts/run.mjs; do not set manually.
# OPENAI_API_KEY / CODEX_API_KEY are not used: the writing client removes them.
# Custom data/runtime/backup directories INSIDE this repository need matching
# .gitignore AND next.config.mjs outputFileTracingExcludes before use/build.
